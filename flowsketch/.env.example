# Holds your Anthropic API key. Read only by the local server; never sent to the browser.
# Leave empty to run in mock mode (sample flow + canned refinements, fully offline).
ANTHROPIC_API_KEY=

# Model used for generation and refinement. Defaults to the latest Claude Sonnet.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Server-side refusal fallback ("default" lets the API pick a fallback model on a refusal; "off" disables).
ANTHROPIC_FALLBACKS=default

# Local API server port (Vite proxies /api to it).
PORT=8787
